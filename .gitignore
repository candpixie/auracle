# raw data never gets committed. the spotify export and any source audio stay local.
data/raw/

# audio outputs are regenerable, and a blanket rule here is the safety net that
# keeps copyrighted source material out of a public repo by accident
*.wav
*.mp3
*.flac
*.m4a

# lab outputs: figures are the artifact and get committed, audio does not
labs/*/out/*
!labs/*/out/*.png

.venv/
__pycache__/
.ipynb_checkpoints/
.DS_Store
cpp/build/

# animation frames are intermediate; the mp4 is the artifact
labs/*/out/_frames/

# ---------------------------------------------------------------------------
# PERSONAL LISTENING HISTORY. NEVER COMMITTED, NEVER PUSHED.
# The Spotify export is a minute-by-minute record of years of private behaviour.
# Everything derived from it stays local too: aggregates still leak taste,
# schedule, and location.
# ---------------------------------------------------------------------------
data/
data/**
*.json.gz
spotify_raw.json
genre_counts.json
top_artists.json
**/Streaming_History_*
**/*listening*
**/*spotify*history*
.spotify-token-cache
